{{ 'component-slideshow.css' | asset_url | stylesheet_tag }}

{%- style -%}
  #shopify-section-{{ section.id }} {
    --aspect-ratio-cusdt: {{ section.settings.height }};
    --aspect-ratio-custb: {{ section.settings.height_tab }};
    --aspect-ratio-cusmb: {{ section.settings.height_mobile }};
    --mg-top: {{ section.settings.mg_top }};
    --mg-right: {{ section.settings.mg_right }};
    --mg-bottom: {{ section.settings.mg_bottom }};
    --mg-left: {{ section.settings.mg_left }};
    --pd-top: {{ section.settings.pd_top }};
    --pd-right: {{ section.settings.pd_right }};
    --pd-bottom: {{ section.settings.pd_bottom }};
    --pd-left: {{ section.settings.pd_left }};
    --overlay-color: {{ section.settings.overlay_color }};
    --overlay-opacity: {{ section.settings.overlay_opacity | divided_by: 100.0 }};
  }
{%- endstyle -%}

{%- liquid
  if section.settings.enable_autoplay
    assign autoplay_val = section.settings.autoplay_speed | append: '.0'
  else
    assign autoplay_val = false
  endif

  if section.settings.enable_loop
    assign wrap_around = true
  else
    assign wrap_around = false
  endif
-%}

{%- capture flickity_config -%}
{
  "cellAlign": "center",
  "freeScroll": 0,
  "contain": 1,
  "dragThreshold": 15,
  "percentPosition": 1,
  "imagesLoaded": 0,
  "lazyload": 0,
  "arrowIcon": "2",
  "t4sid": "template--{{ section.id }}",
  "prevNextButtons": false,
  "pageDots": true,
  "pauseAutoPlayOnHover": true,
  "wrapAround": {{ wrap_around }},
  "autoPlay": {{ autoplay_val }},
  "adaptiveHeight": true
}
{%- endcapture -%}

<div class="t4s-section-inner t4s_nt_se_{{ section.id }}" style="--aspect-ratio-cusdt:{{ section.settings.height }};--aspect-ratio-custb:{{ section.settings.height_tab }};--aspect-ratio-cusmb:{{ section.settings.height_mobile }};--mg-top:{{ section.settings.mg_top }};--mg-right:{{ section.settings.mg_right }};--mg-bottom:{{ section.settings.mg_bottom }};--mg-left:{{ section.settings.mg_left }};--pd-top:{{ section.settings.pd_top }};--pd-right:{{ section.settings.pd_right }};--pd-bottom:{{ section.settings.pd_bottom }};--pd-left:{{ section.settings.pd_left }};">
  <div class="t4s-slideshow t4s-row t4s-row-cols-1 t4s-gx-0 t4s-flicky-slider t4s_position_{{ section.settings.image_position }} t4s_{{ section.settings.image_style }} t4s-slide-eff-{{ section.settings.effect }} t4s-dots-style-{{ section.settings.dots_style }} t4s-dots-cl-{{ section.settings.dots_color }} t4s-dots-default t4s-dots-round-true t4s-dots-hidden-mobile-{{ section.settings.dots_hide_mobile }} {% if section.settings.show_arrows %}t4s-enabled-arrows{% endif %} flickityt4s" data-flickityt4s-js="{{ flickity_config | strip }}" style="--space-dots: {{ section.settings.dots_space }}px;">
    {%- for block in section.blocks -%}
      {%- assign slide_overlay_color = block.settings.overlay_color | default: section.settings.overlay_color -%}
      {%- assign slide_overlay_opacity = block.settings.overlay_opacity | default: section.settings.overlay_opacity -%}
      {%- assign has_link = false -%}
      {%- if block.settings.slide_link != blank -%}
        {%- assign has_link = true -%}
      {%- endif -%}
      <div class="t4s-slideshow-item t4s-col-item t4s-slide t4s_position_{{ section.settings.image_position }}" id="b_{{ block.id }}" data-select-flickity>
        <div class="t4s-slideshow-inner t4s-pr t4s-oh t4s_ratio t4s_ratio_hasmb" style="--aspect-ratioapt:{{ block.settings.image_desktop.aspect_ratio | default: 4.266666 }};--aspect-ratioaptmb:{{ block.settings.image_mobile.aspect_ratio | default: block.settings.image_desktop.aspect_ratio | default: 4.266666 }};">
          {%- if block.settings.image_desktop -%}
            {%- liquid
              assign fetch_priority = 'auto'
              if section.index == 1 and forloop.first
                assign fetch_priority = 'high'
              endif
            -%}
            {%- capture img_class -%}t4s-img-as-bg t4s-d-none t4s-d-md-block -t4s-lz--fadeIn t4s-slide-none{%- endcapture -%}
            {{
              block.settings.image_desktop
              | image_url: width: 3840
              | image_tag: class: img_class, loading: 'eager', fetchpriority: fetch_priority, sizes: '100vw', widths: '100,200,300,400,500,600,700,800,900,1000,1100,1200,1300,1400,1500,1600,1700,1800,1900,2000,2100,2200,2300,2400,2500,2600,2700,2800,2900,3000,3400,3600,3800'
            }}
          {%- endif -%}

          {%- if block.settings.image_mobile -%}
            {%- capture img_class_mb -%}t4s-img-as-bg t4s-d-md-none -t4s-lz--fadeIn t4s-slide-none{%- endcapture -%}
            {{
              block.settings.image_mobile
              | image_url: width: 1000
              | image_tag: class: img_class_mb, loading: 'eager', sizes: '100vw', widths: '375,550,750,1000'
            }}
          {%- endif -%}

          {%- if block.settings.heading != blank or block.settings.subheading != blank or block.settings.description != blank or block.settings.button1_label != blank or block.settings.button2_label != blank -%}
            <div class="t4s-content-wrap t4s-pe-none t4s-full-width-link t4s-z-100">
              <div class="t4s-content-position t4s-{{ block.settings.content_position }} t4s-pa t4s-text-md-{{ block.settings.content_alignment }} t4s-text-{{ block.settings.content_alignment_mobile }} t4s-bg-content-{{ block.settings.content_bg }} t4s-box-content-square-{{ block.settings.content_box_square }} t4s-br-content-{{ block.settings.content_border }} t4s-br-style-solid" style="--time-animation:1s;
                {%- if block.settings.content_position == 'custom' -%}
                  --p-left:{{ block.settings.content_left }}%;--p-hx:-{{ block.settings.content_left }}%;--p-top:{{ block.settings.content_top }}%;--p-vy:-{{ block.settings.content_top }}%;
                  --p-left-mb:{{ block.settings.content_left_mobile }}%;--p-hx-mb:-{{ block.settings.content_left_mobile }}%;--p-top-mb:{{ block.settings.content_top_mobile }}%;--p-vy-mb:-{{ block.settings.content_top_mobile }}%;
                {%- endif -%}
                --bg-content:{{ block.settings.content_bg_color }};
                --content-pd:{{ block.settings.content_padding_desktop }};
                --content-pd-tb:{{ block.settings.content_padding_tablet }};
                --content-pd-mb:{{ block.settings.content_padding_mobile }};
                --bg-content-radius: {{ block.settings.content_border_radius }}%;">
                {%- if block.settings.subheading != blank -%}
                  <p class="t4s-slideshow-subheading" style="color:{{ block.settings.text_color | default: 'inherit' }};">{{ block.settings.subheading }}</p>
                {%- endif -%}
                {%- if block.settings.heading != blank -%}
                  <h2 class="t4s-slideshow-heading {{ block.settings.heading_size }}" style="color:{{ block.settings.text_color | default: 'inherit' }};">{{ block.settings.heading }}</h2>
                {%- endif -%}
                {%- if block.settings.description != blank -%}
                  <div class="t4s-slideshow-desc rte" style="color:{{ block.settings.text_color | default: 'inherit' }};">{{ block.settings.description }}</div>
                {%- endif -%}
                {%- if block.settings.button1_label != blank or block.settings.button2_label != blank -%}
                  <div class="t4s-slideshow-buttons">
                    {%- if block.settings.button1_label != blank -%}
                      <a href="{{ block.settings.button1_link | default: '#' }}" class="t4s-btn t4s-btn-base t4s-btn-style-{{ block.settings.button1_style }} t4s-btn-size-{{ block.settings.button1_size }} t4s-btn-color-{{ block.settings.button1_color }} {% if block.settings.button1_style == 'default' %}t4s-btn-effect-{{ block.settings.button1_effect }}{% endif %} t4s-btn-radius-{{ block.settings.button1_radius }}">{{ block.settings.button1_label }}</a>
                    {%- endif -%}
                    {%- if block.settings.button2_label != blank -%}
                      <a href="{{ block.settings.button2_link | default: '#' }}" class="t4s-btn t4s-btn-base t4s-btn-style-{{ block.settings.button2_style }} t4s-btn-size-{{ block.settings.button2_size }} t4s-btn-color-{{ block.settings.button2_color }} {% if block.settings.button2_style == 'default' %}t4s-btn-effect-{{ block.settings.button2_effect }}{% endif %} t4s-btn-radius-{{ block.settings.button2_radius }}">{{ block.settings.button2_label }}</a>
                    {%- endif -%}
                  </div>
                {%- endif -%}
              </div>
            </div>
          {%- endif -%}

          {%- if has_link -%}
            <a href="{{ block.settings.slide_link }}" target="{% if block.settings.link_target %}_blank{% else %}_self{% endif %}" class="t4s-full-width-link t4s-pe-auto" style="--bg-overlay:{{ slide_overlay_color }};">
          {%- else -%}
            <div class="t4s-full-width-link" style="--bg-overlay:{{ slide_overlay_color }};">
          {%- endif -%}
            <div class="t4s-slide-overlay" style="background:{{ slide_overlay_color }}; opacity:{{ slide_overlay_opacity | divided_by: 100.0 }};"></div>
          {%- if has_link -%}
            </a>
          {%- else -%}
            </div>
          {%- endif -%}
        </div>
      </div>
    {%- endfor -%}
  </div>
</div>

{% schema %}
{
  "name": "Slideshow",
  "tag": "section",
  "class": "t4s-section t4s-section-all t4s_tp_istope",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "header",
      "content": "Dimensions"
    },
    {
      "type": "text",
      "id": "height",
      "label": "Desktop height",
      "default": "700px"
    },
    {
      "type": "text",
      "id": "height_tab",
      "label": "Tablet height",
      "default": "500px"
    },
    {
      "type": "text",
      "id": "height_mobile",
      "label": "Mobile height",
      "default": "250px"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "text",
      "id": "mg_top",
      "label": "Margin top"
    },
    {
      "type": "text",
      "id": "mg_right",
      "label": "Margin right",
      "default": "auto"
    },
    {
      "type": "text",
      "id": "mg_bottom",
      "label": "Margin bottom",
      "default": "30px"
    },
    {
      "type": "text",
      "id": "mg_left",
      "label": "Margin left",
      "default": "auto"
    },
    {
      "type": "text",
      "id": "pd_top",
      "label": "Padding top"
    },
    {
      "type": "text",
      "id": "pd_right",
      "label": "Padding right"
    },
    {
      "type": "text",
      "id": "pd_bottom",
      "label": "Padding bottom"
    },
    {
      "type": "text",
      "id": "pd_left",
      "label": "Padding left"
    },
    {
      "type": "header",
      "content": "Autoplay"
    },
    {
      "type": "checkbox",
      "id": "enable_autoplay",
      "label": "Enable autoplay",
      "default": true
    },
    {
      "type": "range",
      "id": "autoplay_speed",
      "label": "Autoplay speed (ms)",
      "min": 2000,
      "max": 9500,
      "step": 500,
      "default": 5000,
      "unit": "ms"
    },
    {
      "type": "checkbox",
      "id": "enable_loop",
      "label": "Infinite loop",
      "default": true
    },
    {
      "type": "header",
      "content": "Controls"
    },
    {
      "type": "checkbox",
      "id": "show_arrows",
      "label": "Show arrows",
      "default": false
    },
    {
      "type": "header",
      "content": "Dots"
    },
    {
      "type": "select",
      "id": "dots_style",
      "label": "Dots style",
      "options": [
        { "value": "elessi", "label": "Default" },
        { "value": "outline", "label": "Outline" },
        { "value": "br-outline", "label": "Border outline" },
        { "value": "text", "label": "Text" }
      ],
      "default": "elessi"
    },
    {
      "type": "select",
      "id": "dots_color",
      "label": "Dots color",
      "options": [
        { "value": "dark", "label": "Dark" },
        { "value": "light", "label": "Light" },
        { "value": "primary", "label": "Primary" },
        { "value": "custom", "label": "Custom" }
      ],
      "default": "dark"
    },
    {
      "type": "range",
      "id": "dots_space",
      "label": "Dots spacing",
      "min": 0,
      "max": 30,
      "step": 2,
      "default": 10,
      "unit": "px"
    },
    {
      "type": "checkbox",
      "id": "dots_hide_mobile",
      "label": "Hide dots on mobile",
      "default": false
    },
    {
      "type": "header",
      "content": "Slide"
    },
    {
      "type": "select",
      "id": "image_position",
      "label": "Image position",
      "options": [
        { "value": "1", "label": "Top left" },
        { "value": "2", "label": "Top center" },
        { "value": "3", "label": "Top right" },
        { "value": "4", "label": "Center left" },
        { "value": "5", "label": "Center center" },
        { "value": "6", "label": "Center right" },
        { "value": "7", "label": "Bottom left" },
        { "value": "8", "label": "Bottom center" },
        { "value": "9", "label": "Bottom right" }
      ],
      "default": "8"
    },
    {
      "type": "select",
      "id": "image_style",
      "label": "Image style",
      "options": [
        { "value": "cover", "label": "Cover" },
        { "value": "contain", "label": "Contain" },
        { "value": "ratioadapt", "label": "Adapt to image" }
      ],
      "default": "cover"
    },
    {
      "type": "select",
      "id": "effect",
      "label": "Transition effect",
      "options": [
        { "value": "fade", "label": "Fade" },
        { "value": "slide", "label": "Slide" }
      ],
      "default": "fade"
    },
    {
      "type": "header",
      "content": "Overlay"
    },
    {
      "type": "color",
      "id": "overlay_color",
      "label": "Overlay color",
      "default": "#000000"
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "label": "Overlay opacity",
      "min": 0,
      "max": 100,
      "step": 5,
      "default": 20,
      "unit": "%"
    }
  ],
  "blocks": [
    {
      "type": "slide",
      "name": "Slide",
      "limit": 10,
      "settings": [
        {
          "type": "header",
          "content": "Image"
        },
        {
          "type": "image_picker",
          "id": "image_desktop",
          "label": "Desktop image"
        },
        {
          "type": "image_picker",
          "id": "image_mobile",
          "label": "Mobile image"
        },
        {
          "type": "header",
          "content": "Content"
        },
        {
          "type": "text",
          "id": "subheading",
          "label": "Subheading"
        },
        {
          "type": "inline_richtext",
          "id": "heading",
          "label": "Heading"
        },
        {
          "type": "select",
          "id": "heading_size",
          "label": "Heading size",
          "options": [
            { "value": "h2", "label": "Small" },
            { "value": "h1", "label": "Medium" },
            { "value": "h0", "label": "Large" },
            { "value": "hxl", "label": "Extra large" }
          ],
          "default": "h1"
        },
        {
          "type": "richtext",
          "id": "description",
          "label": "Description"
        },
        {
          "type": "header",
          "content": "Buttons"
        },
        {
          "type": "text",
          "id": "button1_label",
          "label": "Button 1 label"
        },
        {
          "type": "url",
          "id": "button1_link",
          "label": "Button 1 link"
        },
        {
          "type": "select",
          "id": "button1_style",
          "label": "Button 1 style",
          "options": [
            { "value": "default", "label": "Default" },
            { "value": "outline", "label": "Outline" },
            { "value": "link", "label": "Link" }
          ],
          "default": "default"
        },
        {
          "type": "select",
          "id": "button1_size",
          "label": "Button 1 size",
          "options": [
            { "value": "small", "label": "Small" },
            { "value": "medium", "label": "Medium" },
            { "value": "large", "label": "Large" },
            { "value": "extra", "label": "Extra large" }
          ],
          "default": "medium"
        },
        {
          "type": "select",
          "id": "button1_color",
          "label": "Button 1 color",
          "options": [
            { "value": "dark", "label": "Dark" },
            { "value": "light", "label": "Light" },
            { "value": "primary", "label": "Primary" },
            { "value": "custom1", "label": "Custom 1" },
            { "value": "custom2", "label": "Custom 2" }
          ],
          "default": "dark"
        },
        {
          "type": "select",
          "id": "button1_effect",
          "label": "Button 1 hover effect",
          "options": [
            { "value": "default", "label": "Default" },
            { "value": "shine", "label": "Shine" }
          ],
          "default": "default"
        },
        {
          "type": "select",
          "id": "button1_radius",
          "label": "Button 1 border radius",
          "options": [
            { "value": "none", "label": "None" },
            { "value": "small", "label": "Small" },
            { "value": "medium", "label": "Medium" },
            { "value": "large", "label": "Large" },
            { "value": "round", "label": "Round" }
          ],
          "default": "round"
        },
        {
          "type": "text",
          "id": "button2_label",
          "label": "Button 2 label"
        },
        {
          "type": "url",
          "id": "button2_link",
          "label": "Button 2 link"
        },
        {
          "type": "select",
          "id": "button2_style",
          "label": "Button 2 style",
          "options": [
            { "value": "default", "label": "Default" },
            { "value": "outline", "label": "Outline" },
            { "value": "link", "label": "Link" }
          ],
          "default": "outline"
        },
        {
          "type": "select",
          "id": "button2_size",
          "label": "Button 2 size",
          "options": [
            { "value": "small", "label": "Small" },
            { "value": "medium", "label": "Medium" },
            { "value": "large", "label": "Large" },
            { "value": "extra", "label": "Extra large" }
          ],
          "default": "medium"
        },
        {
          "type": "select",
          "id": "button2_color",
          "label": "Button 2 color",
          "options": [
            { "value": "dark", "label": "Dark" },
            { "value": "light", "label": "Light" },
            { "value": "primary", "label": "Primary" },
            { "value": "custom1", "label": "Custom 1" },
            { "value": "custom2", "label": "Custom 2" }
          ],
          "default": "light"
        },
        {
          "type": "select",
          "id": "button2_effect",
          "label": "Button 2 hover effect",
          "options": [
            { "value": "default", "label": "Default" },
            { "value": "shine", "label": "Shine" }
          ],
          "default": "default"
        },
        {
          "type": "select",
          "id": "button2_radius",
          "label": "Button 2 border radius",
          "options": [
            { "value": "none", "label": "None" },
            { "value": "small", "label": "Small" },
            { "value": "medium", "label": "Medium" },
            { "value": "large", "label": "Large" },
            { "value": "round", "label": "Round" }
          ],
          "default": "round"
        },
        {
          "type": "header",
          "content": "Layout"
        },
        {
          "type": "select",
          "id": "content_position",
          "label": "Content position",
          "options": [
            { "value": "auto", "label": "Center" },
            { "value": "custom", "label": "Custom" }
          ],
          "default": "auto"
        },
        {
          "type": "range",
          "id": "content_left",
          "label": "Horizontal position (%)",
          "min": 0,
          "max": 100,
          "step": 1,
          "default": 50,
          "unit": "%"
        },
        {
          "type": "range",
          "id": "content_top",
          "label": "Vertical position (%)",
          "min": 0,
          "max": 100,
          "step": 1,
          "default": 50,
          "unit": "%"
        },
        {
          "type": "range",
          "id": "content_left_mobile",
          "label": "Horizontal position mobile (%)",
          "min": 0,
          "max": 100,
          "step": 1,
          "default": 50,
          "unit": "%"
        },
        {
          "type": "range",
          "id": "content_top_mobile",
          "label": "Vertical position mobile (%)",
          "min": 0,
          "max": 100,
          "step": 1,
          "default": 50,
          "unit": "%"
        },
        {
          "type": "select",
          "id": "content_alignment",
          "label": "Text alignment desktop",
          "options": [
            { "value": "start", "label": "Left" },
            { "value": "center", "label": "Center" },
            { "value": "end", "label": "Right" }
          ],
          "default": "center"
        },
        {
          "type": "select",
          "id": "content_alignment_mobile",
          "label": "Text alignment mobile",
          "options": [
            { "value": "start", "label": "Left" },
            { "value": "center", "label": "Center" },
            { "value": "end", "label": "Right" }
          ],
          "default": "center"
        },
        {
          "type": "color",
          "id": "text_color",
          "label": "Text color"
        },
        {
          "type": "header",
          "content": "Content background"
        },
        {
          "type": "checkbox",
          "id": "content_bg",
          "label": "Enable background",
          "default": false
        },
        {
          "type": "color",
          "id": "content_bg_color",
          "label": "Background color",
          "default": "rgba(255, 255, 255, 0.0)"
        },
        {
          "type": "checkbox",
          "id": "content_box_square",
          "label": "Square box",
          "default": false
        },
        {
          "type": "checkbox",
          "id": "content_border",
          "label": "Border",
          "default": false
        },
        {
          "type": "range",
          "id": "content_border_radius",
          "label": "Border radius (%)",
          "min": 0,
          "max": 50,
          "step": 1,
          "default": 0,
          "unit": "%"
        },
        {
          "type": "text",
          "id": "content_padding_desktop",
          "label": "Padding desktop",
          "default": "15px 15px"
        },
        {
          "type": "text",
          "id": "content_padding_tablet",
          "label": "Padding tablet",
          "default": "15px 15px"
        },
        {
          "type": "text",

{%- style -%}
  #shopify-section-{{ section.id }} {
    --video-section-bg: {{ section.settings.bg_color }};
    --video-title-color: {{ section.settings.title_color }};
    --video-title-size: {{ section.settings.title_size }}px;
    --video-grid-gap: {{ section.settings.grid_gap }}px;
    --video-border-radius: {{ section.settings.video_radius }}px;
    --video-pt: {{ section.settings.padding_top }}px;
    --video-pb: {{ section.settings.padding_bottom }}px;
    --video-page-width: {{ section.settings.page_width }}px;
  }

  .custom-video-section-{{ section.id }} {
    background: var(--video-section-bg);
    padding-top: var(--video-pt, var(--section-py-desktop));
    padding-bottom: var(--video-pb, var(--section-py-desktop));
  }

  .custom-video-section-{{ section.id }} .page-width {
    max-width: var(--video-page-width, var(--container-max-width));
    margin: 0 auto;
    padding-left: var(--section-px-desktop);
    padding-right: var(--section-px-desktop);
  }

  .custom-video-section-{{ section.id }} .video-title {
    color: var(--video-title-color);
    font-size: var(--video-title-size);
    text-align: {{ section.settings.title_align }};
    margin: 0 0 var(--heading-mb-desktop);
    line-height: 1.2;
  }

  .custom-video-section-{{ section.id }} .video-container {
    display: grid;
    grid-template-columns: repeat({{ section.settings.columns_desktop }}, 1fr);
    gap: var(--video-grid-gap, var(--gap-lg));
  }

  .custom-video-section-{{ section.id }} .video-item {
    overflow: hidden;
    border-radius: var(--video-border-radius);
    background: #000;
    line-height: 0;
  }

  .custom-video-section-{{ section.id }} .video-item video {
    width: 100%;
    height: auto;
    display: block;
    aspect-ratio: {{ section.settings.video_aspect }};
    object-fit: cover;
  }

  @media screen and (max-width: 990px) {
    .custom-video-section-{{ section.id }} .video-container {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media screen and (max-width: 749px) {
    .custom-video-section-{{ section.id }} {
      padding-top: var(--section-py-mobile);
      padding-bottom: var(--section-py-mobile);
    }
    .custom-video-section-{{ section.id }} .page-width {
      padding-left: var(--section-px-mobile);
      padding-right: var(--section-px-mobile);
    }
  }

  @media screen and (max-width: 600px) {
    .custom-video-section-{{ section.id }} .video-container {
      grid-template-columns: 1fr;
    }
  }
{%- endstyle -%}

<div class="custom-video-section-{{ section.id }}">
  <div class="page-width">
    {% if section.settings.title != blank %}
      <h2 class="video-title">{{ section.settings.title }}</h2>
    {% endif %}

    <div class="video-container">
      {% for block in section.blocks %}
        {% if block.settings.show_video %}
        <div class="video-item" {{ block.shopify_attributes }}>
          {% if block.settings.video != blank %}
            {{ block.settings.video | video_tag: controls: true, image_size: '600x', autoplay: block.settings.autoplay_video, loop: block.settings.loop_video, muted: block.settings.mute_video, playsinline: true, loading: 'lazy' }}
          {% else %}
            <video controls>
              <source src="{{ block.settings.video_url }}" type="video/mp4">
              Your browser does not support the video tag.
            </video>
          {% endif %}
        </div>
        {% endif %}
      {% else %}
        {% for i in (1..3) %}
          <div class="video-item">
            <video controls>
              <source src="https://cdn.shopify.com/videos/c/o/v/{{ i }}.mp4" type="video/mp4">
              Your browser does not support the video tag.
            </video>
          </div>
        {% endfor %}
      {% endfor %}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Product Videos",
  "tag": "section",
  "class": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "header",
      "content": "Heading"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Title",
      "default": "Product Videos"
    },
    {
      "type": "select",
      "id": "title_align",
      "label": "Title alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ],
      "default": "center"
    },
    {
      "type": "color",
      "id": "title_color",
      "label": "Title color",
      "default": "#000000"
    },
    {
      "type": "range",
      "id": "title_size",
      "label": "Title size",
      "min": 16,
      "max": 60,
      "step": 2,
      "default": 32,
      "unit": "px"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background color",
      "default": "#ffffff"
    },
    {
      "type": "range",
      "id": "page_width",
      "label": "Page width",
      "min": 800,
      "max": 1600,
      "step": 20,
      "default": 1400,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "label": "Columns on desktop",
      "min": 1,
      "max": 6,
      "step": 1,
      "default": 3
    },
    {
      "type": "range",
      "id": "grid_gap",
      "label": "Grid gap",
      "min": 0,
      "max": 60,
      "step": 5,
      "default": 20,
      "unit": "px"
    },
    {
      "type": "select",
      "id": "video_aspect",
      "label": "Video aspect ratio",
      "options": [
        { "value": "9/16", "label": "Portrait (9:16)" },
        { "value": "3/4", "label": "Portrait (3:4)" },
        { "value": "1/1", "label": "Square (1:1)" },
        { "value": "4/3", "label": "Landscape (4:3)" },
        { "value": "16/9", "label": "Landscape (16:9)" }
      ],
      "default": "9/16"
    },
    {
      "type": "range",
      "id": "video_radius",
      "label": "Video border radius",
      "min": 0,
      "max": 30,
      "step": 2,
      "default": 8,
      "unit": "px"
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 150,
      "step": 5,
      "unit": "px",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 150,
      "step": 5,
      "unit": "px",
      "default": 80
    }
  ],
  "blocks": [
    {
      "type": "video_item",
      "name": "Video Item",
      "settings": [
        {
          "type": "checkbox",
          "id": "show_video",
          "label": "Show video",
          "default": true
        },
        {
          "type": "video",
          "id": "video",
          "label": "Video file"
        },
        {
          "type": "url",
          "id": "video_url",
          "label": "Video URL (fallback)",
          "info": "Direct video URL used if no video file is uploaded"
        },
        {
          "type": "checkbox",
          "id": "loop_video",
          "label": "Loop video",
          "default": false
        },
        {
          "type": "checkbox",
          "id": "autoplay_video",
          "label": "Autoplay video",
          "default": false
        },
        {
          "type": "checkbox",
          "id": "mute_video",
          "label": "Mute video",
          "default": true
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Product Videos",
      "blocks": [
        { "type": "video_item" },
        { "type": "video_item" },
        { "type": "video_item" }
      ]
    }
  ]
}
{% endschema %}

{{ 'custom-footer-bottom.css' | asset_url | stylesheet_tag }}
<script src="{{ 'custom-footer-bottom.js' | asset_url }}" defer></script>

<section
  class="cf-bottom color-{{ section.settings.color_scheme }}"
  style="
    --cfb-bg: {{ section.settings.bg_color }};
    --cfb-text: {{ section.settings.text_color }};
    --cfb-link: {{ section.settings.link_color }};
    --cfb-link-hover: {{ section.settings.link_hover_color }};
    --cfb-accent: {{ section.settings.accent_color }};
    --cfb-border: {{ section.settings.border_color }};
    --cfb-pt: {{ section.settings.padding_top }}px;
    --cfb-pb: {{ section.settings.padding_bottom }}px;
  "
>
  {%- if section.settings.show_divider -%}
    <div class="cf-bottom__divider" aria-hidden="true"></div>
  {%- endif -%}

  <div class="cf-bottom__container">

    {%- comment -%} Blocks Rendered {%- endcomment -%}
    {%- for block in section.blocks -%}
      {%- case block.type -%}

        {%- when 'copyright' -%}
          <div class="cf-bottom__row cf-bottom__row--copyright" {{ block.shopify_attributes }}>
            <div class="cf-bottom__copyright-inner">

              {%- if block.settings.show_logo and block.settings.logo != blank -%}
                <a href="{{ routes.root_url }}" class="cf-bottom__logo" aria-label="{{ shop.name }}">
                  {{ block.settings.logo | image_url: width: 300 | image_tag:
                    loading: 'lazy',
                    width: block.settings.logo.width,
                    height: block.settings.logo.height,
                    alt: shop.name,
                    class: 'cf-bottom__logo-img',
                    style: 'max-width:' | append: block.settings.logo_width | append: 'px'
                  }}
                </a>
              {%- endif -%}

              <div class="cf-bottom__copyright-text">
                {%- if block.settings.copyright_text != blank -%}
                  <p class="cf-bottom__copyright">
                    © {{ 'now' | date: '%Y' }} 
                    <span class="cf-bottom__brand">{{ block.settings.copyright_text }}</span>
                    {%- if block.settings.rights_text != blank -%}
                      <span class="cf-bottom__rights">{{ block.settings.rights_text }}</span>
                    {%- endif -%}
                  </p>
                {%- endif -%}

                {%- if block.settings.trade_license != blank -%}
                  <p class="cf-bottom__license">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                      <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/>
                      <polyline points="14 2 14 8 20 8"/>
                      <line x1="9" y1="15" x2="15" y2="15"/>
                    </svg>
                    {{ block.settings.trade_license }}
                  </p>
                {%- endif -%}
              </div>

              {%- if block.settings.show_legal_links -%}
                <ul class="cf-bottom__legal-links">
                  {%- if block.settings.link1_text != blank -%}
                    <li>
                      <a href="{{ block.settings.link1_url }}" class="cf-bottom__legal-link">
                        {{- block.settings.link1_text -}}
                      </a>
                    </li>
                  {%- endif -%}
                  {%- if block.settings.link2_text != blank -%}
                    <li>
                      <a href="{{ block.settings.link2_url }}" class="cf-bottom__legal-link">
                        {{- block.settings.link2_text -}}
                      </a>
                    </li>
                  {%- endif -%}
                  {%- if block.settings.link3_text != blank -%}
                    <li>
                      <a href="{{ block.settings.link3_url }}" class="cf-bottom__legal-link">
                        {{- block.settings.link3_text -}}
                      </a>
                    </li>
                  {%- endif -%}
                </ul>
              {%- endif -%}
            </div>
          </div>

        {%- when 'payments' -%}
          <div class="cf-bottom__row cf-bottom__row--payments" {{ block.shopify_attributes }}>
            {%- if block.settings.heading != blank -%}
              <div class="cf-bottom__payments-header">
                <span class="cf-bottom__payments-heading">{{ block.settings.heading }}</span>
                {%- if block.settings.secure_badge -%}
                  <span class="cf-bottom__secure-badge">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                      <rect x="3" y="11" width="18" height="11" rx="2" ry="2"/>
                      <path d="M7 11V7a5 5 0 0 1 10 0v4"/>
                    </svg>
                    {{ block.settings.secure_text | default: '100% Secure' }}
                  </span>
                {%- endif -%}
              </div>
            {%- endif -%}

            <div class="cf-bottom__payments-wrap">
              {%- if block.settings.payment_image != blank -%}
                <div class="cf-bottom__payments">
                  {{ block.settings.payment_image | image_url: width: 1600 | image_tag:
                    loading: 'lazy',
                    width: block.settings.payment_image.width,
                    height: block.settings.payment_image.height,
                    alt: 'Accepted payment methods',
                    class: 'cf-bottom__payment-img'
                  }}
                </div>
              {%- endif -%}

              {%- if block.settings.verified_image != blank -%}
                <div class="cf-bottom__verified">
                  {%- if block.settings.verified_label != blank -%}
                    <span class="cf-bottom__verified-label">{{ block.settings.verified_label }}</span>
                  {%- endif -%}
                  {{ block.settings.verified_image | image_url: width: 300 | image_tag:
                    loading: 'lazy',
                    width: block.settings.verified_image.width,
                    height: block.settings.verified_image.height,
                    alt: 'Verified',
                    class: 'cf-bottom__verified-img'
                  }}
                </div>
              {%- endif -%}
            </div>
          </div>

        {%- when 'text' -%}
          <div class="cf-bottom__row cf-bottom__row--text" {{ block.shopify_attributes }}>
            {%- if block.settings.text != blank -%}
              <div class="cf-bottom__custom-text">
                {{ block.settings.text }}
              </div>
            {%- endif -%}
          </div>

      {%- endcase -%}
    {%- endfor -%}
  </div>

  {%- comment -%} Back to Top Button {%- endcomment -%}
  {%- if section.settings.show_back_to_top -%}
    <button
      type="button"
      class="cf-bottom__back-to-top"
      data-back-to-top
      aria-label="Back to top"
      title="Back to top"
    >
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <line x1="12" y1="19" x2="12" y2="5"/>
        <polyline points="5 12 12 5 19 12"/>
      </svg>
    </button>
  {%- endif -%}
</section>

{% schema %}
{
  "name": "Custom Footer Bottom",
  "tag": "section",
  "class": "cf-bottom-section",
  "settings": [
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "checkbox",
      "id": "show_divider",
      "label": "Show top divider line",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_back_to_top",
      "label": "Show 'Back to Top' button",
      "default": true
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "background-1"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background color",
      "default": "#f6f6f8"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#6b7280"
    },
    {
      "type": "color",
      "id": "link_color",
      "label": "Link color",
      "default": "#6b7280"
    },
    {
      "type": "color",
      "id": "link_hover_color",
      "label": "Link hover color",
      "default": "#17a953"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent color",
      "default": "#17a953"
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "Border color",
      "default": "#e5e7eb"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding top",
      "min": 0,
      "max": 80,
      "step": 2,
      "unit": "px",
      "default": 24
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding bottom",
      "min": 0,
      "max": 80,
      "step": 2,
      "unit": "px",
      "default": 24
    }
  ],
  "blocks": [
    {
      "type": "copyright",
      "name": "Copyright",
      "limit": 1,
      "settings": [
        {
          "type": "checkbox",
          "id": "show_logo",
          "label": "Show logo",
          "default": false
        },
        {
          "type": "image_picker",
          "id": "logo",
          "label": "Logo"
        },
        {
          "type": "range",
          "id": "logo_width",
          "label": "Logo width",
          "min": 60,
          "max": 300,
          "step": 10,
          "unit": "px",
          "default": 120
        },
        {
          "type": "text",
          "id": "copyright_text",
          "label": "Brand name",
          "default": "Grammo Food"
        },
        {
          "type": "text",
          "id": "rights_text",
          "label": "Rights text",
          "default": "All rights reserved"
        },
        {
          "type": "text",
          "id": "trade_license",
          "label": "Trade License / Extra Info",
          "default": "Trade Licence Number: 17451"
        },
        {
          "type": "header",
          "content": "Legal Links"
        },
        {
          "type": "checkbox",
          "id": "show_legal_links",
          "label": "Show legal links",
          "default": true
        },
        {
          "type": "text",
          "id": "link1_text",
          "label": "Link 1 text",
          "default": "Privacy Policy"
        },
        {
          "type": "url",
          "id": "link1_url",
          "label": "Link 1 URL"
        },
        {
          "type": "text",
          "id": "link2_text",
          "label": "Link 2 text",
          "default": "Terms of Service"
        },
        {
          "type": "url",
          "id": "link2_url",
          "label": "Link 2 URL"
        },
        {
          "type": "text",
          "id": "link3_text",
          "label": "Link 3 text",
          "default": "Refund Policy"
        },
        {
          "type": "url",
          "id": "link3_url",
          "label": "Link 3 URL"
        }
      ]
    },
    {
      "type": "payments",
      "name": "Payment Methods",
      "limit": 1,
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "We Accept"
        },
        {
          "type": "checkbox",
          "id": "secure_badge",
          "label": "Show 'Secure' badge",
          "default": true
        },
        {
          "type": "text",
          "id": "secure_text",
          "label": "Secure badge text",
          "default": "100% Secure Checkout"
        },
        {
          "type": "image_picker",
          "id": "payment_image",
          "label": "Payment methods image",
          "info": "Upload combined payment logos strip"
        },
        {
          "type": "header",
          "content": "Verified Badge (e.g. SSL)"
        },
        {
          "type": "text",
          "id": "verified_label",
          "label": "Verified label",
          "default": "Verified by"
        },
        {
          "type": "image_picker",
          "id": "verified_image",
          "label": "Verified badge image (e.g. SSLCommerz)"
        }
      ]
    },
    {
      "type": "text",
      "name": "Custom Text / HTML",
      "settings": [
        {
          "type": "richtext",
          "id": "text",
          "label": "Text content",
          "default": "<p>Made with ❤️ in Bangladesh</p>"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Custom Footer Bottom",
      "blocks": [
        { "type": "copyright" },
        { "type": "payments" }
      ]
    }
  ]
}
{% endschema %}
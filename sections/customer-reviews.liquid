{{ 'customer-reviews.css' | asset_url | stylesheet_tag }}
<script src="{{ 'customer-reviews.js' | asset_url }}" defer></script>

<section
  class="customer-reviews color-{{ section.settings.color_scheme }} gradient"
  style="
    --cr-padding-top: {{ section.settings.padding_top }}px;
    --cr-padding-bottom: {{ section.settings.padding_bottom }}px;
    --cr-accent: {{ section.settings.accent_color }};
    --cr-grid-gap: {{ section.settings.cards_gap }}px;
  "
>
  <div class="customer-reviews__container page-width">
    {%- if section.settings.heading != blank or section.settings.subheading != blank -%}
      <div class="customer-reviews__header">
        {%- if section.settings.subheading != blank -%}
          <span class="customer-reviews__eyebrow">{{ section.settings.subheading }}</span>
        {%- endif -%}
        {%- if section.settings.heading != blank -%}
          <h2 class="customer-reviews__heading">{{ section.settings.heading }}</h2>
        {%- endif -%}
        {%- if section.settings.description != blank -%}
          <p class="customer-reviews__description">{{ section.settings.description }}</p>
        {%- endif -%}
      </div>
    {%- endif -%}

    <div class="customer-reviews__grid">
      {%- comment -%} LEFT SIDE: Testimonial Carousel {%- endcomment -%}
      <div class="customer-reviews__carousel-wrapper">
        <div
          class="customer-reviews__carousel"
          data-carousel
          data-autoplay="{{ section.settings.autoplay }}"
          data-autoplay-speed="{{ section.settings.autoplay_speed | times: 1000 }}"
        >
          <div class="customer-reviews__track" data-track>
            {%- for block in section.blocks -%}
              {%- if block.type == 'testimonial' -%}
                <article
                  class="customer-reviews__slide {% if forloop.first %}is-active{% endif %}"
                  data-slide
                  data-index="{{ forloop.index0 }}"
                  {% if block.settings.proof_image != blank %}
                    data-proof-image="{{ block.settings.proof_image | image_url: width: 800 }}"
                    data-proof-alt="{{ block.settings.proof_image.alt | default: block.settings.name | escape }}"
                  {% endif %}
                  {{ block.shopify_attributes }}
                >
                  {%- if block.settings.rating > 0 -%}
                    <div class="customer-reviews__rating" aria-label="{{ block.settings.rating }} out of 5 stars">
                      {%- for i in (1..5) -%}
                        <svg
                          class="customer-reviews__star {% if i <= block.settings.rating %}is-filled{% endif %}"
                          viewBox="0 0 24 24"
                          fill="currentColor"
                          aria-hidden="true"
                        >
                          <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/>
                        </svg>
                      {%- endfor -%}
                    </div>
                  {%- endif -%}

                  {%- if block.settings.review_text != blank -%}
                    <blockquote class="customer-reviews__quote">
                      <svg class="customer-reviews__quote-icon" viewBox="0 0 32 32" fill="currentColor" aria-hidden="true">
                        <path d="M9.352 4C4.456 7.456 1 13.12 1 19.36 1 24.832 4.32 28 8.32 28c3.776 0 6.56-3.008 6.56-6.56 0-3.552-2.464-6.144-5.696-6.144-.64 0-1.504.128-1.728.256.576-3.904 4.224-8.512 7.872-10.816L9.352 4zm16.512 0C21.032 7.456 17.576 13.12 17.576 19.36c0 5.472 3.328 8.64 7.328 8.64 3.712 0 6.56-3.008 6.56-6.56 0-3.552-2.528-6.144-5.76-6.144-.64 0-1.44.128-1.664.256.576-3.904 4.16-8.512 7.808-10.816L25.864 4z"/>
                      </svg>
                      <p class="customer-reviews__text">{{ block.settings.review_text }}</p>
                    </blockquote>
                  {%- endif -%}

                  <footer class="customer-reviews__author">
                    {%- if block.settings.avatar != blank -%}
                      <div class="customer-reviews__avatar">
                        {{ block.settings.avatar | image_url: width: 100 | image_tag:
                          loading: 'lazy',
                          width: 50,
                          height: 50,
                          alt: block.settings.name
                        }}
                      </div>
                    {%- else -%}
                      {%- if block.settings.name != blank -%}
                        <div class="customer-reviews__avatar customer-reviews__avatar--initial">
                          <span>{{ block.settings.name | slice: 0 | upcase }}</span>
                        </div>
                      {%- endif -%}
                    {%- endif -%}

                    <div class="customer-reviews__author-info">
                      {%- if block.settings.name != blank -%}
                        <cite class="customer-reviews__name">{{ block.settings.name }}</cite>
                      {%- endif -%}
                      {%- if block.settings.location != blank -%}
                        <span class="customer-reviews__location">
                          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                            <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/>
                            <circle cx="12" cy="10" r="3"/>
                          </svg>
                          {{ block.settings.location }}
                        </span>
                      {%- endif -%}
                      {%- if block.settings.verified -%}
                        <span class="customer-reviews__verified">
                          <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                            <path d="M12 2L4 6v6c0 5.55 3.84 10.74 8 12 4.16-1.26 8-6.45 8-12V6l-8-4zm-1.06 14L7 12.06l1.41-1.41 2.53 2.53 5.11-5.11L17.47 9.5l-6.53 6.5z"/>
                          </svg>
                          Verified Buyer
                        </span>
                      {%- endif -%}
                    </div>
                  </footer>
                </article>
              {%- endif -%}
            {%- endfor -%}
          </div>

          {%- if section.blocks.size > 1 -%}
            <div class="customer-reviews__controls">
              <button
                class="customer-reviews__nav customer-reviews__nav--prev"
                data-prev
                type="button"
                aria-label="Previous review"
              >
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M15 18l-6-6 6-6"/>
                </svg>
              </button>

              <div class="customer-reviews__dots" data-dots>
                {%- for block in section.blocks -%}
                  <button
                    class="customer-reviews__dot {% if forloop.first %}is-active{% endif %}"
                    data-dot
                    data-index="{{ forloop.index0 }}"
                    type="button"
                    aria-label="Go to review {{ forloop.index }}"
                  ></button>
                {%- endfor -%}
              </div>

              <button
                class="customer-reviews__nav customer-reviews__nav--next"
                data-next
                type="button"
                aria-label="Next review"
              >
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M9 18l6-6-6-6"/>
                </svg>
              </button>
            </div>
          {%- endif -%}
        </div>
      </div>

      {%- comment -%} RIGHT SIDE: Proof Image {%- endcomment -%}
      <div class="customer-reviews__proof-wrapper">
        <div class="customer-reviews__proof" data-proof-container>
          <div class="customer-reviews__proof-badge">
            <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M12 2L4 6v6c0 5.55 3.84 10.74 8 12 4.16-1.26 8-6.45 8-12V6l-8-4zm-1.06 14L7 12.06l1.41-1.41 2.53 2.53 5.11-5.11L17.47 9.5l-6.53 6.5z"/>
            </svg>
            <span>{{ section.settings.badge_text | default: 'Verified Review' }}</span>
          </div>

          <div class="customer-reviews__proof-image-wrapper">
            {%- for block in section.blocks -%}
              {%- if block.type == 'testimonial' and block.settings.proof_image != blank -%}
                <img
                  class="customer-reviews__proof-image {% if forloop.first %}is-active{% endif %}"
                  data-proof-slide
                  data-index="{{ forloop.index0 }}"
                  src="{{ block.settings.proof_image | image_url: width: 800 }}"
                  alt="{{ block.settings.proof_image.alt | default: block.settings.name | escape }}"
                  loading="lazy"
                  width="600"
                  height="600"
                >
              {%- endif -%}
            {%- endfor -%}

            {%- if section.blocks.size == 0 -%}
              <div class="customer-reviews__proof-placeholder">
                {{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder-svg' }}
              </div>
            {%- endif -%}
          </div>

          {%- if section.settings.stats_enabled -%}
            <div class="customer-reviews__stats">
              <div class="customer-reviews__stat">
                <strong>{{ section.settings.stat_1_number }}</strong>
                <span>{{ section.settings.stat_1_label }}</span>
              </div>
              <div class="customer-reviews__stat">
                <strong>{{ section.settings.stat_2_number }}</strong>
                <span>{{ section.settings.stat_2_label }}</span>
              </div>
            </div>
          {%- endif -%}
        </div>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Customer Reviews",
  "tag": "section",
  "class": "section-customer-reviews",
  "settings": [
    {
      "type": "header",
      "content": "Section Header"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Eyebrow Text",
      "default": "TESTIMONIALS"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Customers Love"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "See what our happy customers have to say about their experience."
    },
    {
      "type": "header",
      "content": "Right Side Content"
    },
    {
      "type": "text",
      "id": "badge_text",
      "label": "Proof Badge Text",
      "default": "Verified Review"
    },
    {
      "type": "checkbox",
      "id": "stats_enabled",
      "label": "Show statistics",
      "default": true
    },
    {
      "type": "text",
      "id": "stat_1_number",
      "label": "Stat 1 Number",
      "default": "10K+"
    },
    {
      "type": "text",
      "id": "stat_1_label",
      "label": "Stat 1 Label",
      "default": "Happy Customers"
    },
    {
      "type": "text",
      "id": "stat_2_number",
      "label": "Stat 2 Number",
      "default": "4.9/5"
    },
    {
      "type": "text",
      "id": "stat_2_label",
      "label": "Stat 2 Label",
      "default": "Average Rating"
    },
    {
      "type": "header",
      "content": "Carousel Settings"
    },
    {
      "type": "checkbox",
      "id": "autoplay",
      "label": "Enable autoplay",
      "default": true
    },
    {
      "type": "range",
      "id": "autoplay_speed",
      "label": "Autoplay speed (seconds)",
      "min": 3,
      "max": 15,
      "step": 1,
      "default": 6
    },
    {
      "type": "header",
      "content": "Appearance"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "background-1"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent color",
      "default": "#22c55e"
    },
    {
      "type": "range",
      "id": "cards_gap",
      "label": "Gap between cards",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 60
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding top",
      "min": 0,
      "max": 150,
      "step": 5,
      "unit": "px",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding bottom",
      "min": 0,
      "max": 150,
      "step": 5,
      "unit": "px",
      "default": 80
    }
  ],
  "blocks": [
    {
      "type": "testimonial",
      "name": "Testimonial",
      "settings": [
        {
          "type": "text",
          "id": "name",
          "label": "Customer Name",
          "default": "Abdulla Chowdhury"
        },
        {
          "type": "text",
          "id": "location",
          "label": "Location",
          "default": "Dhaka, Bangladesh"
        },
        {
          "type": "image_picker",
          "id": "avatar",
          "label": "Customer Avatar"
        },
        {
          "type": "range",
          "id": "rating",
          "label": "Star Rating",
          "min": 0,
          "max": 5,
          "step": 1,
          "default": 5
        },
        {
          "type": "checkbox",
          "id": "verified",
          "label": "Show verified badge",
          "default": true
        },
        {
          "type": "textarea",
          "id": "review_text",
          "label": "Review Text",
          "default": "গ্রাম্য ফুড থেকে তুলশী মালা চাল ও অন্যান্য কিছু পণ্য নিয়েছিলাম আলহামদুলিল্লাহ সকল পণ্যই ভালো হয়েছে। ধন্যবাদ গ্রাম্য ফুড বিশুদ্ধ পণ্য সরবরাহ করার জন্য।"
        },
        {
          "type": "image_picker",
          "id": "proof_image",
          "label": "Proof Image (screenshot/photo)",
          "info": "Displays on the right side as social proof"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Customer Reviews",
      "blocks": [
        { "type": "testimonial" },
        { "type": "testimonial" },
        { "type": "testimonial" }
      ]
    }
  ]
}
{% endschema %}
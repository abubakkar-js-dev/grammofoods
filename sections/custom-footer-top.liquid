{{ 'custom-footer-top.css' | asset_url | stylesheet_tag }}
<script src="{{ 'custom-footer-top.js' | asset_url }}" defer></script>

<style>
  .cf-top__heading::after {
    background: {{ section.settings.underline_color }};
    height: {{ section.settings.underline_width }}px;
  }
  .cf-top--no-underline .cf-top__heading::after {
    display: none;
  }
  .cf-top .cf-top__grid {
    column-gap: var(--cf-column-gap, 30px);
  }
  .cf-top__menu-list--2col {
    display: grid;
    grid-template-columns: 1fr 1fr;
    column-gap: 16px;
  }
  .cf-top__menu-empty {
    margin: 0;
    font-size: 1rem;
    color: var(--cf-text-color, #6b7280);
  }
  .cf-top__social-link {
    width: var(--cf-social-size, 40px);
    height: var(--cf-social-size, 40px);
    border-radius: var(--cf-social-radius, 12px);
  }
  .cf-top__social-link svg {
    width: var(--cf-social-icon-size, 18px);
    height: var(--cf-social-icon-size, 18px);
  }
  .cf-top__social-list--labeled {
    flex-direction: column;
    align-items: flex-start;
    gap: 8px;
  }
  .cf-top__social-list--labeled .cf-top__social-link {
    width: auto;
    height: auto;
    padding: 8px 16px;
    justify-content: flex-start;
    gap: 10px;
  }
  .cf-top__social-label {
    font-size: 0.95rem;
    font-weight: 500;
  }
  .cf-top__richtext-image {
    width: 100%;
    height: auto;
    border-radius: 12px;
    margin-bottom: 16px;
  }
  .cf-top__richtext {
    font-size: 1rem;
    color: var(--cf-text-color, #6b7280);
    line-height: 1.6;
  }
  .cf-top__richtext p:first-child {
    margin-top: 0;
  }
  .cf-top__richtext img {
    max-width: 100%;
    height: auto;
    border-radius: 12px;
  }
  .cf-top__richtext a {
    color: var(--cf-link-color, #6b7280);
  }
</style>

<section
  class="cf-top color-{{ section.settings.color_scheme }}{% unless section.settings.show_underline %} cf-top--no-underline{% endunless %}"
  style="
    --cf-bg: {{ section.settings.bg_color }};
    --cf-heading-color: {{ section.settings.heading_color }};
    --cf-text-color: {{ section.settings.text_color }};
    --cf-link-color: {{ section.settings.link_color }};
    --cf-link-hover: {{ section.settings.link_hover_color }};
    --cf-accent: {{ section.settings.accent_color }};
    --cf-border: {{ section.settings.border_color }};
    --cf-column-gap: {{ section.settings.column_gap }}px;
    --cf-pt: {{ section.settings.padding_top }}px;
    --cf-pb: {{ section.settings.padding_bottom }}px;
    --cf-pt-mb: {{ section.settings.padding_top_mobile }}px;
    --cf-pb-mb: {{ section.settings.padding_bottom_mobile }}px;
  "
>
  <div class="cf-top__container">
    <div class="cf-top__grid">
      {%- for block in section.blocks -%}
        {%- case block.type -%}

          {%- when 'contact' -%}
            <div class="cf-top__col cf-top__col--contact" {{ block.shopify_attributes }}>
              <div class="cf-top__heading-wrap" data-collapse-toggle>
                <h3 class="cf-top__heading">{{ block.settings.heading }}</h3>
                <span class="cf-top__collapse-icon" aria-hidden="true">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M6 9l6 6 6-6"/>
                  </svg>
                </span>
              </div>

              <div class="cf-top__content" data-collapse-content>
                <ul class="cf-top__contact-list">
                  {%- if block.settings.show_address and block.settings.address != blank -%}
                    <li class="cf-top__contact-item">
                      <span class="cf-top__contact-icon"{% unless block.settings.address_use_accent %} style="color: {{ block.settings.address_icon_color }}; background: {{ block.settings.address_icon_color | color_modify: 'alpha', 0.08 }}"{% endunless %}>
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                          <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/>
                          <circle cx="12" cy="10" r="3"/>
                        </svg>
                      </span>
                      <span class="cf-top__contact-text">{{ block.settings.address }}</span>
                    </li>
                  {%- endif -%}

                  {%- if block.settings.show_email and block.settings.email != blank -%}
                    <li class="cf-top__contact-item">
                      <span class="cf-top__contact-icon"{% unless block.settings.email_use_accent %} style="color: {{ block.settings.email_icon_color }}; background: {{ block.settings.email_icon_color | color_modify: 'alpha', 0.08 }}"{% endunless %}>
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                          <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/>
                          <polyline points="22,6 12,13 2,6"/>
                        </svg>
                      </span>
                      {%- if block.settings.email_link_enabled -%}
                        <a href="mailto:{{ block.settings.email }}" class="cf-top__contact-text cf-top__contact-link">
                          {{ block.settings.email }}
                        </a>
                      {%- else -%}
                        <span class="cf-top__contact-text">{{ block.settings.email }}</span>
                      {%- endif -%}
                    </li>
                  {%- endif -%}

                  {%- if block.settings.show_phone and block.settings.phone != blank -%}
                    <li class="cf-top__contact-item">
                      <span class="cf-top__contact-icon"{% unless block.settings.phone_use_accent %} style="color: {{ block.settings.phone_icon_color }}; background: {{ block.settings.phone_icon_color | color_modify: 'alpha', 0.08 }}"{% endunless %}>
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                          <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/>
                        </svg>
                      </span>
                      {%- if block.settings.phone_link_enabled -%}
                        <a href="tel:{{ block.settings.phone | replace: ' ', '' | replace: '-', '' }}" class="cf-top__contact-text cf-top__contact-link">
                          {{ block.settings.phone }}
                        </a>
                      {%- else -%}
                        <span class="cf-top__contact-text">{{ block.settings.phone }}</span>
                      {%- endif -%}
                    </li>
                  {%- endif -%}

                  {%- if block.settings.show_hours and block.settings.hours != blank -%}
                    <li class="cf-top__contact-item">
                      <span class="cf-top__contact-icon"{% unless block.settings.hours_use_accent %} style="color: {{ block.settings.hours_icon_color }}; background: {{ block.settings.hours_icon_color | color_modify: 'alpha', 0.08 }}"{% endunless %}>
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                          <circle cx="12" cy="12" r="10"/>
                          <polyline points="12 6 12 12 16 14"/>
                        </svg>
                      </span>
                      <span class="cf-top__contact-text">{{ block.settings.hours }}</span>
                    </li>
                  {%- endif -%}
                </ul>
              </div>
            </div>

          {%- when 'menu' -%}
            <div class="cf-top__col cf-top__col--menu" {{ block.shopify_attributes }}>
              <div class="cf-top__heading-wrap" data-collapse-toggle>
                <h3 class="cf-top__heading">{{ block.settings.heading }}</h3>
                <span class="cf-top__collapse-icon" aria-hidden="true">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M6 9l6 6 6-6"/>
                  </svg>
                </span>
              </div>

              <div class="cf-top__content" data-collapse-content>
                {%- if block.settings.menu != blank -%}
                  {%- assign menu_links = linklists[block.settings.menu].links -%}
                  {%- if menu_links == blank -%}
                    {%- assign menu_links = block.settings.menu.links -%}
                  {%- endif -%}
                  {%- if menu_links.size > 0 -%}
                    <ul class="cf-top__menu-list{% if block.settings.columns == '2' %} cf-top__menu-list--2col{% endif %}">
                      {%- for link in menu_links -%}
                        <li>
                          <a href="{{ link.url }}" class="cf-top__menu-link">
                            <span class="cf-top__menu-arrow" aria-hidden="true">
                              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M5 12h14"/>
                                <path d="M12 5l7 7-7 7"/>
                              </svg>
                            </span>
                            <span>{{ link.title }}</span>
                          </a>
                        </li>
                      {%- endfor -%}
                    </ul>
                  {%- else -%}
                    <p class="cf-top__menu-empty">No menu items found</p>
                  {%- endif -%}
                {%- else -%}
                  <p class="cf-top__menu-empty">Please select a menu in theme editor</p>
                {%- endif -%}
              </div>
            </div>

          {%- when 'social' -%}
            {%- assign social_size = '40px' -%}
            {%- assign social_icon = '18px' -%}
            {%- case block.settings.icon_size -%}
              {%- when 'small' -%}
                {%- assign social_size = '32px' -%}
                {%- assign social_icon = '16px' -%}
              {%- when 'large' -%}
                {%- assign social_size = '48px' -%}
                {%- assign social_icon = '22px' -%}
            {%- endcase -%}
            {%- assign social_radius = '12px' -%}
            {%- case block.settings.icon_shape -%}
              {%- when 'circle' -%}
                {%- assign social_radius = '50%' -%}
              {%- when 'square' -%}
                {%- assign social_radius = '0px' -%}
            {%- endcase -%}

            <div class="cf-top__col cf-top__col--social" {{ block.shopify_attributes }}>
              <div class="cf-top__heading-wrap" data-collapse-toggle>
                <h3 class="cf-top__heading">{{ block.settings.heading }}</h3>
                <span class="cf-top__collapse-icon" aria-hidden="true">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M6 9l6 6 6-6"/>
                  </svg>
                </span>
              </div>

              <div class="cf-top__content" data-collapse-content>
                {%- if block.settings.description != blank -%}
                  <p class="cf-top__social-desc">{{ block.settings.description }}</p>
                {%- endif -%}

                <ul class="cf-top__social-list{% if block.settings.label_style == 'labeled' %} cf-top__social-list--labeled{% endif %}" style="--cf-social-size: {{ social_size }}; --cf-social-icon-size: {{ social_icon }}; --cf-social-radius: {{ social_radius }};">
                  {%- if block.settings.show_facebook and block.settings.facebook != blank -%}
                    <li>
                      <a href="{{ block.settings.facebook }}" class="cf-top__social-link" aria-label="Facebook" target="_blank" rel="noopener">
                        <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                          <path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/>
                        </svg>
                        <span class="cf-top__social-label">Facebook</span>
                      </a>
                    </li>
                  {%- endif -%}

                  {%- if block.settings.show_instagram and block.settings.instagram != blank -%}
                    <li>
                      <a href="{{ block.settings.instagram }}" class="cf-top__social-link" aria-label="Instagram" target="_blank" rel="noopener">
                        <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                          <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.052.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98C8.333 23.986 8.741 24 12 24c3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 100 12.324 6.162 6.162 0 000-12.324zM12 16a4 4 0 110-8 4 4 0 010 8zm6.406-11.845a1.44 1.44 0 100 2.881 1.44 1.44 0 000-2.881z"/>
                        </svg>
                        <span class="cf-top__social-label">Instagram</span>
                      </a>
                    </li>
                  {%- endif -%}

                  {%- if block.settings.show_youtube and block.settings.youtube != blank -%}
                    <li>
                      <a href="{{ block.settings.youtube }}" class="cf-top__social-link" aria-label="YouTube" target="_blank" rel="noopener">
                        <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                          <path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/>
                        </svg>
                        <span class="cf-top__social-label">YouTube</span>
                      </a>
                    </li>
                  {%- endif -%}

                  {%- if block.settings.show_twitter and block.settings.twitter != blank -%}
                    <li>
                      <a href="{{ block.settings.twitter }}" class="cf-top__social-link" aria-label="Twitter" target="_blank" rel="noopener">
                        <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                          <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/>
                        </svg>
                        <span class="cf-top__social-label">Twitter</span>
                      </a>
                    </li>
                  {%- endif -%}

                  {%- if block.settings.show_tiktok and block.settings.tiktok != blank -%}
                    <li>
                      <a href="{{ block.settings.tiktok }}" class="cf-top__social-link" aria-label="TikTok" target="_blank" rel="noopener">
                        <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                          <path d="M12.525.02c1.31-.02 2.61-.01 3.91-.02.08 1.53.63 3.09 1.75 4.17 1.12 1.11 2.7 1.62 4.24 1.79v4.03c-1.44-.05-2.89-.35-4.2-.97-.57-.26-1.1-.59-1.62-.93-.01 2.92.01 5.84-.02 8.75-.08 1.4-.54 2.79-1.35 3.94-1.31 1.92-3.58 3.17-5.91 3.21-1.43.08-2.86-.31-4.08-1.03-2.02-1.19-3.44-3.37-3.65-5.71-.02-.5-.03-1-.01-1.49.18-1.9 1.12-3.72 2.58-4.96 1.66-1.44 3.98-2.13 6.15-1.72.02 1.48-.04 2.96-.04 4.44-.99-.32-2.15-.23-3.02.37-.63.41-1.11 1.04-1.36 1.75-.21.51-.15 1.07-.14 1.61.24 1.64 1.82 3.02 3.5 2.87 1.12-.01 2.19-.66 2.77-1.61.19-.33.4-.67.41-1.06.1-1.79.06-3.57.07-5.36.01-4.03-.01-8.05.02-12.07z"/>
                        </svg>
                        <span class="cf-top__social-label">TikTok</span>
                      </a>
                    </li>
                  {%- endif -%}

                  {%- if block.settings.show_linkedin and block.settings.linkedin != blank -%}
                    <li>
                      <a href="{{ block.settings.linkedin }}" class="cf-top__social-link" aria-label="LinkedIn" target="_blank" rel="noopener">
                        <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                          <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.225 0z"/>
                        </svg>
                        <span class="cf-top__social-label">LinkedIn</span>
                      </a>
                    </li>
                  {%- endif -%}

                  {%- if block.settings.show_pinterest and block.settings.pinterest != blank -%}
                    <li>
                      <a href="{{ block.settings.pinterest }}" class="cf-top__social-link" aria-label="Pinterest" target="_blank" rel="noopener">
                        <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                          <path d="M12.017 0C5.396 0 .029 5.367.029 11.987c0 5.079 3.158 9.417 7.618 11.162-.105-.949-.199-2.403.041-3.439.219-.937 1.406-5.957 1.406-5.957s-.359-.72-.359-1.781c0-1.663.967-2.911 2.168-2.911 1.024 0 1.518.769 1.518 1.688 0 1.029-.653 2.567-.992 3.992-.285 1.193.6 2.165 1.775 2.165 2.128 0 3.768-2.245 3.768-5.487 0-2.861-2.063-4.869-5.008-4.869-3.41 0-5.409 2.562-5.409 5.199 0 1.033.394 2.143.889 2.741.099.12.112.225.085.345-.09.375-.293 1.199-.334 1.363-.053.225-.172.271-.401.165-1.495-.69-2.433-2.878-2.433-4.646 0-3.776 2.748-7.252 7.92-7.252 4.158 0 7.392 2.967 7.392 6.923 0 4.135-2.607 7.462-6.233 7.462-1.214 0-2.354-.629-2.758-1.379l-.749 2.848c-.269 1.045-1.004 2.352-1.498 3.146 1.123.345 2.306.535 3.55.535 6.607 0 11.985-5.365 11.985-11.987C23.97 5.39 18.592.026 11.985.026L12.017 0z"/>
                        </svg>
                        <span class="cf-top__social-label">Pinterest</span>
                      </a>
                    </li>
                  {%- endif -%}

                  {%- if block.settings.show_whatsapp and block.settings.whatsapp != blank -%}
                    <li>
                      <a href="{{ block.settings.whatsapp }}" class="cf-top__social-link" aria-label="WhatsApp" target="_blank" rel="noopener">
                        <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                          <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/>
                        </svg>
                        <span class="cf-top__social-label">WhatsApp</span>
                      </a>
                    </li>
                  {%- endif -%}
                </ul>
              </div>
            </div>

          {%- when 'newsletter' -%}
            <div class="cf-top__col cf-top__col--newsletter" {{ block.shopify_attributes }}>
              <div class="cf-top__heading-wrap" data-collapse-toggle>
                <h3 class="cf-top__heading">{{ block.settings.heading }}</h3>
                <span class="cf-top__collapse-icon" aria-hidden="true">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M6 9l6 6 6-6"/>
                  </svg>
                </span>
              </div>

              <div class="cf-top__content" data-collapse-content>
                {%- if block.settings.description != blank -%}
                  <p class="cf-top__newsletter-desc">{{ block.settings.description }}</p>
                {%- endif -%}

                {%- form 'customer', class: 'cf-top__newsletter-form', novalidate: 'novalidate' -%}
                  <input type="hidden" name="contact[tags]" value="newsletter">

                  <div class="cf-top__input-wrap">
                    <input
                      type="email"
                      name="contact[email]"
                      id="cf-newsletter-{{ section.id }}"
                      class="cf-top__input"
                      placeholder="{{ block.settings.placeholder }}"
                      aria-label="{{ block.settings.placeholder }}"
                      required
                      autocomplete="email"
                    >
                    <button type="submit" class="cf-top__submit" aria-label="{{ block.settings.button_text }}">
                      <span class="cf-top__submit-text">{{ block.settings.button_text }}</span>
                      <span class="cf-top__submit-icon" aria-hidden="true">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                          <path d="M5 12h14"/>
                          <path d="M12 5l7 7-7 7"/>
                        </svg>
                      </span>
                    </button>
                  </div>

                  {%- if form.errors -%}
                    <div class="cf-top__form-message cf-top__form-message--error">
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <circle cx="12" cy="12" r="10"/>
                        <line x1="12" y1="8" x2="12" y2="12"/>
                        <line x1="12" y1="16" x2="12.01" y2="16"/>
                      </svg>
                      {{ form.errors.translated_fields.email | capitalize }} {{ form.errors.messages.email }}
                    </div>
                  {%- endif -%}

                  {%- if form.posted_successfully? -%}
                    <div class="cf-top__form-message cf-top__form-message--success">
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/>
                        <polyline points="22 4 12 14.01 9 11.01"/>
                      </svg>
                      {{ block.settings.success_message }}
                    </div>
                  {%- endif -%}
                {%- endform -%}

                {%- if block.settings.badges_enabled -%}
                  <div class="cf-top__trust-badges">
                    <span class="cf-top__trust-badge">
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <rect x="3" y="11" width="18" height="11" rx="2" ry="2"/>
                        <path d="M7 11V7a5 5 0 0 1 10 0v4"/>
                      </svg>
                      {{ block.settings.badge_1_text }}
                    </span>
                    <span class="cf-top__trust-badge">
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M20 6L9 17l-5-5"/>
                      </svg>
                      {{ block.settings.badge_2_text }}
                    </span>
                  </div>
                {%- endif -%}
              </div>
            </div>

          {%- when 'richtext' -%}
            <div class="cf-top__col cf-top__col--richtext" {{ block.shopify_attributes }}>
              <div class="cf-top__heading-wrap" data-collapse-toggle>
                <h3 class="cf-top__heading">{{ block.settings.heading }}</h3>
                <span class="cf-top__collapse-icon" aria-hidden="true">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M6 9l6 6 6-6"/>
                  </svg>
                </span>
              </div>

              <div class="cf-top__content" data-collapse-content>
                {%- if block.settings.image != blank -%}
                  {{ block.settings.image | image_url: width: 800 | image_tag: loading: 'lazy', class: 'cf-top__richtext-image', alt: block.settings.image.alt | escape }}
                {%- endif -%}
                {%- if block.settings.richtext != blank -%}
                  <div class="cf-top__richtext rte">{{ block.settings.richtext }}</div>
                {%- endif -%}
              </div>
            </div>

        {%- endcase -%}
      {%- endfor -%}
    </div>
  </div>
</section>


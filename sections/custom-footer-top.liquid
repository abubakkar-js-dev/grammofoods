{{ 'custom-footer-top.css' | asset_url | stylesheet_tag }}
<script src="{{ 'custom-footer-top.js' | asset_url }}" defer></script>

<style>
  .cf-top__heading::after {
    background: {{ section.settings.underline_color | default: '#17a953' }};
    height: {{ section.settings.underline_width | default: 2 }}px;
  }
  .cf-top--no-underline .cf-top__heading::after {
    display: none;
  }
  .cf-top .cf-top__grid {
    column-gap: var(--cf-column-gap, 30px);
  }
  .cf-top__menu-list--2col {
    display: grid;
    grid-template-columns: 1fr 1fr;
    column-gap: 16px;
  }
  .cf-top__menu-empty {
    margin: 0;
    font-size: 1rem;
    color: var(--cf-text-color, #6b7280);
  }
  .cf-top__richtext-image {
    width: 100%;
    height: auto;
    border-radius: 12px;
    margin-bottom: 16px;
  }
  .cf-top__richtext {
    font-size: 1rem;
    color: var(--cf-text-color, #6b7280);
    line-height: 1.6;
  }
  .cf-top__richtext p:first-child {
    margin-top: 0;
  }
  .cf-top__richtext img {
    max-width: 100%;
    height: auto;
    border-radius: 12px;
  }
  .cf-top__richtext a {
    color: var(--cf-link-color, #6b7280);
  }
</style>

<section
  class="cf-top color-{{ section.settings.color_scheme }}{% unless section.settings.show_underline %} cf-top--no-underline{% endunless %}"
  style="
    --cf-bg: {{ section.settings.bg_color }};
    --cf-heading-color: {{ section.settings.heading_color }};
    --cf-text-color: {{ section.settings.text_color }};
    --cf-link-color: {{ section.settings.link_color }};
    --cf-link-hover: {{ section.settings.link_hover_color }};
    --cf-accent: {{ section.settings.accent_color }};
    --cf-border: {{ section.settings.border_color }};
    --cf-column-gap: {{ section.settings.column_gap }}px;
    --cf-pt: {{ section.settings.padding_top }}px;
    --cf-pb: {{ section.settings.padding_bottom }}px;
    --cf-pt-mb: {{ section.settings.padding_top_mobile }}px;
    --cf-pb-mb: {{ section.settings.padding_bottom_mobile }}px;
  "
>
  <div class="cf-top__container">
    <div class="cf-top__grid">
      {%- for block in section.blocks -%}
        {%- case block.type -%}

          {%- when 'contact' -%}
            <div class="cf-top__col cf-top__col--contact" {{ block.shopify_attributes }}>
              <div class="cf-top__heading-wrap" data-collapse-toggle>
                <h3 class="cf-top__heading">{{ block.settings.heading }}</h3>
                <span class="cf-top__collapse-icon" aria-hidden="true">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M6 9l6 6 6-6"/>
                  </svg>
                </span>
              </div>

              <div class="cf-top__content" data-collapse-content>
                <ul class="cf-top__contact-list">
                  {%- if block.settings.show_address and block.settings.address != blank -%}
                    <li class="cf-top__contact-item">
                      <span class="cf-top__contact-icon"{% unless block.settings.address_use_accent %} style="color: {{ block.settings.address_icon_color }}; background: {{ block.settings.address_icon_color | color_modify: 'alpha', 0.08 }}"{% endunless %}>
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                          <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/>
                          <circle cx="12" cy="10" r="3"/>
                        </svg>
                      </span>
                      <span class="cf-top__contact-text">{{ block.settings.address }}</span>
                    </li>
                  {%- endif -%}

                  {%- if block.settings.show_email and block.settings.email != blank -%}
                    <li class="cf-top__contact-item">
                      <span class="cf-top__contact-icon"{% unless block.settings.email_use_accent %} style="color: {{ block.settings.email_icon_color }}; background: {{ block.settings.email_icon_color | color_modify: 'alpha', 0.08 }}"{% endunless %}>
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                          <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/>
                          <polyline points="22,6 12,13 2,6"/>
                        </svg>
                      </span>
                      {%- if block.settings.email_link_enabled -%}
                        <a href="mailto:{{ block.settings.email }}" class="cf-top__contact-text cf-top__contact-link">
                          {{ block.settings.email }}
                        </a>
                      {%- else -%}
                        <span class="cf-top__contact-text">{{ block.settings.email }}</span>
                      {%- endif -%}
                    </li>
                  {%- endif -%}

                  {%- if block.settings.show_phone and block.settings.phone != blank -%}
                    <li class="cf-top__contact-item">
                      <span class="cf-top__contact-icon"{% unless block.settings.phone_use_accent %} style="color: {{ block.settings.phone_icon_color }}; background: {{ block.settings.phone_icon_color | color_modify: 'alpha', 0.08 }}"{% endunless %}>
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                          <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/>
                        </svg>
                      </span>
                      {%- if block.settings.phone_link_enabled -%}
                        <a href="tel:{{ block.settings.phone | replace: ' ', '' | replace: '-', '' }}" class="cf-top__contact-text cf-top__contact-link">
                          {{ block.settings.phone }}
                        </a>
                      {%- else -%}
                        <span class="cf-top__contact-text">{{ block.settings.phone }}</span>
                      {%- endif -%}
                    </li>
                  {%- endif -%}

                  {%- if block.settings.show_hours and block.settings.hours != blank -%}
                    <li class="cf-top__contact-item">
                      <span class="cf-top__contact-icon"{% unless block.settings.hours_use_accent %} style="color: {{ block.settings.hours_icon_color }}; background: {{ block.settings.hours_icon_color | color_modify: 'alpha', 0.08 }}"{% endunless %}>
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                          <circle cx="12" cy="12" r="10"/>
                          <polyline points="12 6 12 12 16 14"/>
                        </svg>
                      </span>
                      <span class="cf-top__contact-text">{{ block.settings.hours }}</span>
                    </li>
                  {%- endif -%}
                </ul>
              </div>
            </div>

          {%- when 'menu' -%}
            <div class="cf-top__col cf-top__col--menu" {{ block.shopify_attributes }}>
              <div class="cf-top__heading-wrap" data-collapse-toggle>
                <h3 class="cf-top__heading">{{ block.settings.heading | default: 'Menu' }}</h3>
                <span class="cf-top__collapse-icon" aria-hidden="true">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M6 9l6 6 6-6"/>
                  </svg>
                </span>
              </div>

              <div class="cf-top__content" data-collapse-content>
                {%- assign menu_links = block.settings.menu.links -%}
                {%- if menu_links == blank -%}
                  {%- assign menu_links = linklists[block.settings.menu].links -%}
                {%- endif -%}
                {%- if menu_links.size > 0 -%}
                  <ul class="cf-top__menu-list">
                    {%- for link in menu_links -%}
                      <li>
                        <a href="{{ link.url }}" class="cf-top__menu-link">
                          {{ link.title | escape }}
                        </a>
                      </li>
                    {%- endfor -%}
                  </ul>
                {%- else -%}
                  <p class="cf-top__menu-empty" style="opacity:0.6;font-size:0.85rem;">
                    Please select a menu in theme editor.
                  </p>
                {%- endif -%}
              </div>
            </div>

          {%- when 'social' -%}
            <div class="cf-top__col cf-top__col--social" {{ block.shopify_attributes }}>
              <div class="cf-top__heading-wrap" data-collapse-toggle>
                <h3 class="cf-top__heading">{{ block.settings.heading | default: 'Follow Us' }}</h3>
                <span class="cf-top__collapse-icon" aria-hidden="true">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M6 9l6 6 6-6"/>
                  </svg>
                </span>
              </div>

              <div class="cf-top__content" data-collapse-content>
                {%- if block.settings.description != blank -%}
                  <p class="cf-top__social-desc">{{ block.settings.description }}</p>
                {%- endif -%}

                <ul class="cf-top__menu-list">
                  {%- if block.settings.facebook != blank -%}
                    <li>
                      <a href="{{ block.settings.facebook }}" class="cf-top__menu-link" target="_blank" rel="noopener">
                        Facebook
                      </a>
                    </li>
                  {%- endif -%}
                  {%- if block.settings.instagram != blank -%}
                    <li>
                      <a href="{{ block.settings.instagram }}" class="cf-top__menu-link" target="_blank" rel="noopener">
                        Instagram
                      </a>
                    </li>
                  {%- endif -%}
                  {%- if block.settings.youtube != blank -%}
                    <li>
                      <a href="{{ block.settings.youtube }}" class="cf-top__menu-link" target="_blank" rel="noopener">
                        YouTube
                      </a>
                    </li>
                  {%- endif -%}
                  {%- if block.settings.twitter != blank -%}
                    <li>
                      <a href="{{ block.settings.twitter }}" class="cf-top__menu-link" target="_blank" rel="noopener">
                        Twitter
                      </a>
                    </li>
                  {%- endif -%}
                  {%- if block.settings.tiktok != blank -%}
                    <li>
                      <a href="{{ block.settings.tiktok }}" class="cf-top__menu-link" target="_blank" rel="noopener">
                        TikTok
                      </a>
                    </li>
                  {%- endif -%}
                  {%- if block.settings.linkedin != blank -%}
                    <li>
                      <a href="{{ block.settings.linkedin }}" class="cf-top__menu-link" target="_blank" rel="noopener">
                        LinkedIn
                      </a>
                    </li>
                  {%- endif -%}
                  {%- if block.settings.pinterest != blank -%}
                    <li>
                      <a href="{{ block.settings.pinterest }}" class="cf-top__menu-link" target="_blank" rel="noopener">
                        Pinterest
                      </a>
                    </li>
                  {%- endif -%}
                  {%- if block.settings.whatsapp != blank -%}
                    <li>
                      <a href="{{ block.settings.whatsapp }}" class="cf-top__menu-link" target="_blank" rel="noopener">
                        WhatsApp
                      </a>
                    </li>
                  {%- endif -%}
                </ul>
              </div>
            </div>

          {%- when 'newsletter' -%}
            <div class="cf-top__col cf-top__col--newsletter" {{ block.shopify_attributes }}>
              <div class="cf-top__heading-wrap" data-collapse-toggle>
                <h3 class="cf-top__heading">{{ block.settings.heading | default: 'Sign Up & Save' }}</h3>
                <span class="cf-top__collapse-icon" aria-hidden="true">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M6 9l6 6 6-6"/>
                  </svg>
                </span>
              </div>

              <div class="cf-top__content" data-collapse-content>
                {%- if block.settings.description != blank -%}
                  <p class="cf-top__newsletter-desc">{{ block.settings.description }}</p>
                {%- endif -%}

                {%- form 'customer', class: 'cf-top__newsletter-form', novalidate: 'novalidate' -%}
                  <input type="hidden" name="contact[tags]" value="newsletter">

                  <div class="cf-top__input-wrap">
                    <input
                      type="email"
                      name="contact[email]"
                      id="cf-newsletter-{{ section.id }}"
                      class="cf-top__input"
                      placeholder="{{ block.settings.placeholder | default: 'Your email address' }}"
                      aria-label="{{ block.settings.placeholder | default: 'Your email address' }}"
                      required
                      autocomplete="email"
                    >
                    <button type="submit" class="cf-top__submit" aria-label="{{ block.settings.button_text | default: 'Subscribe' }}">
                      <span class="cf-top__submit-text">{{ block.settings.button_text | default: 'Subscribe' }}</span>
                      <span class="cf-top__submit-icon" aria-hidden="true">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                          <path d="M5 12h14"/>
                          <path d="M12 5l7 7-7 7"/>
                        </svg>
                      </span>
                    </button>
                  </div>

                  {%- if form.errors -%}
                    <div class="cf-top__form-message cf-top__form-message--error">
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <circle cx="12" cy="12" r="10"/>
                        <line x1="12" y1="8" x2="12" y2="12"/>
                        <line x1="12" y1="16" x2="12.01" y2="16"/>
                      </svg>
                      {{ form.errors.translated_fields.email | capitalize }} {{ form.errors.messages.email }}
                    </div>
                  {%- endif -%}

                  {%- if form.posted_successfully? -%}
                    <div class="cf-top__form-message cf-top__form-message--success">
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/>
                        <polyline points="22 4 12 14.01 9 11.01"/>
                      </svg>
                      {{ block.settings.success_message | default: 'Thanks for subscribing!' }}
                    </div>
                  {%- endif -%}
                {%- endform -%}

                {%- if block.settings.badges_enabled -%}
                  <div class="cf-top__trust-badges">
                    <span class="cf-top__trust-badge">
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <rect x="3" y="11" width="18" height="11" rx="2" ry="2"/>
                        <path d="M7 11V7a5 5 0 0 1 10 0v4"/>
                      </svg>
                      {{ block.settings.badge_1_text | default: 'No spam' }}
                    </span>
                    <span class="cf-top__trust-badge">
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M20 6L9 17l-5-5"/>
                      </svg>
                      {{ block.settings.badge_2_text | default: 'Unsubscribe anytime' }}
                    </span>
                  </div>
                {%- endif -%}
              </div>
            </div>

          {%- when 'richtext' -%}
            <div class="cf-top__col cf-top__col--richtext" {{ block.shopify_attributes }}>
              <div class="cf-top__heading-wrap" data-collapse-toggle>
                <h3 class="cf-top__heading">{{ block.settings.heading }}</h3>
                <span class="cf-top__collapse-icon" aria-hidden="true">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M6 9l6 6 6-6"/>
                  </svg>
                </span>
              </div>

              <div class="cf-top__content" data-collapse-content>
                {%- if block.settings.image != blank -%}
                  {{ block.settings.image | image_url: width: 800 | image_tag: loading: 'lazy', class: 'cf-top__richtext-image', alt: block.settings.image.alt | escape }}
                {%- endif -%}
                {%- if block.settings.richtext != blank -%}
                  <div class="cf-top__richtext rte">{{ block.settings.richtext }}</div>
                {%- endif -%}
              </div>
            </div>

        {%- endcase -%}
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Custom Footer Top",
  "tag": "section",
  "class": "cf-top-section",
  "settings": [
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background color",
      "default": "#f6f6f8"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading color",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#6b7280"
    },
    {
      "type": "color",
      "id": "link_color",
      "label": "Link color",
      "default": "#6b7280"
    },
    {
      "type": "color",
      "id": "link_hover_color",
      "label": "Link hover color",
      "default": "#17a953"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent color",
      "default": "#17a953"
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "Border color",
      "default": "#e5e7eb"
    },
    {
      "type": "header",
      "content": "Headings"
    },
    {
      "type": "checkbox",
      "id": "show_underline",
      "label": "Show accent underline under headings",
      "default": true
    },
    {
      "type": "color",
      "id": "underline_color",
      "label": "Underline color",
      "default": "#17a953"
    },
    {
      "type": "range",
      "id": "underline_width",
      "label": "Underline width",
      "min": 1,
      "max": 5,
      "step": 1,
      "unit": "px",
      "default": 2
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "column_gap",
      "label": "Column gap",
      "min": 0,
      "max": 80,
      "step": 2,
      "unit": "px",
      "default": 30
    },
    {
      "type": "header",
      "content": "Spacing (Desktop)"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding top",
      "min": 0,
      "max": 150,
      "step": 5,
      "unit": "px",
      "default": 75
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding bottom",
      "min": 0,
      "max": 150,
      "step": 5,
      "unit": "px",
      "default": 40
    },
    {
      "type": "header",
      "content": "Spacing (Mobile)"
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "label": "Padding top (mobile)",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "default": 45
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "label": "Padding bottom (mobile)",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "default": 20
    }
  ],
  "blocks": [
    {
      "type": "contact",
      "name": "Contact Info",
      "limit": 1,
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Contact Us"
        },
        {
          "type": "header",
          "content": "Address"
        },
        {
          "type": "checkbox",
          "id": "show_address",
          "label": "Show address",
          "default": true
        },
        {
          "type": "textarea",
          "id": "address",
          "label": "Address",
          "default": "Shop #2, Omrbin Khattb Mosjid Market, Greatwall City, Gazipur"
        },
        {
          "type": "checkbox",
          "id": "address_use_accent",
          "label": "Use accent color for icon",
          "default": true
        },
        {
          "type": "color",
          "id": "address_icon_color",
          "label": "Address icon color",
          "default": "#17a953"
        },
        {
          "type": "header",
          "content": "Email"
        },
        {
          "type": "checkbox",
          "id": "show_email",
          "label": "Show email",
          "default": true
        },
        {
          "type": "text",
          "id": "email",
          "label": "Email",
          "default": "grammofoods@gmail.com"
        },
        {
          "type": "checkbox",
          "id": "email_link_enabled",
          "label": "Make email clickable (mailto:)",
          "default": true
        },
        {
          "type": "checkbox",
          "id": "email_use_accent",
          "label": "Use accent color for icon",
          "default": true
        },
        {
          "type": "color",
          "id": "email_icon_color",
          "label": "Email icon color",
          "default": "#17a953"
        },
        {
          "type": "header",
          "content": "Phone"
        },
        {
          "type": "checkbox",
          "id": "show_phone",
          "label": "Show phone",
          "default": true
        },
        {
          "type": "text",
          "id": "phone",
          "label": "Phone",
          "default": "+8809611900245"
        },
        {
          "type": "checkbox",
          "id": "phone_link_enabled",
          "label": "Make phone clickable (tel:)",
          "default": true
        },
        {
          "type": "checkbox",
          "id": "phone_use_accent",
          "label": "Use accent color for icon",
          "default": true
        },
        {
          "type": "color",
          "id": "phone_icon_color",
          "label": "Phone icon color",
          "default": "#17a953"
        },
        {
          "type": "header",
          "content": "Working Hours"
        },
        {
          "type": "checkbox",
          "id": "show_hours",
          "label": "Show working hours",
          "default": true
        },
        {
          "type": "text",
          "id": "hours",
          "label": "Working hours",
          "default": "Sat - Thu: 9:00 AM - 8:00 PM"
        },
        {
          "type": "checkbox",
          "id": "hours_use_accent",
          "label": "Use accent color for icon",
          "default": true
        },
        {
          "type": "color",
          "id": "hours_icon_color",
          "label": "Working hours icon color",
          "default": "#17a953"
        }
      ]
    },
    {
      "type": "menu",
      "name": "Menu",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Information"
        },
        {
          "type": "link_list",
          "id": "menu",
          "label": "Menu",
          "info": "Select a menu from Online Store → Navigation"
        }
      ]
    },
    {
      "type": "social",
      "name": "Social Links",
      "limit": 1,
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Follow Us"
        },
        {
          "type": "text",
          "id": "description",
          "label": "Description",
          "default": "Stay connected on social media"

{{ 'custom-footer-top.css' | asset_url | stylesheet_tag }}
<script src="{{ 'custom-footer-top.js' | asset_url }}" defer></script>

<section
  class="cf-top color-{{ section.settings.color_scheme }}"
  style="
    --cf-bg: {{ section.settings.bg_color }};
    --cf-heading-color: {{ section.settings.heading_color }};
    --cf-text-color: {{ section.settings.text_color }};
    --cf-link-color: {{ section.settings.link_color }};
    --cf-link-hover: {{ section.settings.link_hover_color }};
    --cf-accent: {{ section.settings.accent_color }};
    --cf-border: {{ section.settings.border_color }};
    --cf-pt: {{ section.settings.padding_top }}px;
    --cf-pb: {{ section.settings.padding_bottom }}px;
    --cf-pt-mb: {{ section.settings.padding_top_mobile }}px;
    --cf-pb-mb: {{ section.settings.padding_bottom_mobile }}px;
  "
>
  <div class="cf-top__container">
    <div class="cf-top__grid">
      {%- for block in section.blocks -%}
        {%- case block.type -%}

          {%- when 'contact' -%}
            <div class="cf-top__col cf-top__col--contact" {{ block.shopify_attributes }}>
              <div class="cf-top__heading-wrap" data-collapse-toggle>
                <h3 class="cf-top__heading">{{ block.settings.heading }}</h3>
                <span class="cf-top__collapse-icon" aria-hidden="true">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M6 9l6 6 6-6"/>
                  </svg>
                </span>
              </div>

              <div class="cf-top__content" data-collapse-content>
                <ul class="cf-top__contact-list">
                  {%- if block.settings.address != blank -%}
                    <li class="cf-top__contact-item">
                      <span class="cf-top__contact-icon">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                          <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/>
                          <circle cx="12" cy="10" r="3"/>
                        </svg>
                      </span>
                      <span class="cf-top__contact-text">{{ block.settings.address }}</span>
                    </li>
                  {%- endif -%}

                  {%- if block.settings.email != blank -%}
                    <li class="cf-top__contact-item">
                      <span class="cf-top__contact-icon">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                          <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/>
                          <polyline points="22,6 12,13 2,6"/>
                        </svg>
                      </span>
                      <a href="mailto:{{ block.settings.email }}" class="cf-top__contact-text cf-top__contact-link">
                        {{ block.settings.email }}
                      </a>
                    </li>
                  {%- endif -%}

                  {%- if block.settings.phone != blank -%}
                    <li class="cf-top__contact-item">
                      <span class="cf-top__contact-icon">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                          <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/>
                        </svg>
                      </span>
                      <a href="tel:{{ block.settings.phone | replace: ' ', '' | replace: '-', '' }}" class="cf-top__contact-text cf-top__contact-link">
                        {{ block.settings.phone }}
                      </a>
                    </li>
                  {%- endif -%}

                  {%- if block.settings.hours != blank -%}
                    <li class="cf-top__contact-item">
                      <span class="cf-top__contact-icon">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                          <circle cx="12" cy="12" r="10"/>
                          <polyline points="12 6 12 12 16 14"/>
                        </svg>
                      </span>
                      <span class="cf-top__contact-text">{{ block.settings.hours }}</span>
                    </li>
                  {%- endif -%}
                </ul>
              </div>
            </div>

          {%- when 'menu' -%}
            <div class="cf-top__col cf-top__col--menu" {{ block.shopify_attributes }}>
              <div class="cf-top__heading-wrap" data-collapse-toggle>
                <h3 class="cf-top__heading">{{ block.settings.heading }}</h3>
                <span class="cf-top__collapse-icon" aria-hidden="true">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M6 9l6 6 6-6"/>
                  </svg>
                </span>
              </div>

              <div class="cf-top__content" data-collapse-content>
                {%- if block.settings.menu != blank -%}
                  <ul class="cf-top__menu-list">
                    {%- for link in linklists[block.settings.menu].links -%}
                      <li>
                        <a href="{{ link.url }}" class="cf-top__menu-link">
                          <span class="cf-top__menu-arrow" aria-hidden="true">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                              <path d="M5 12h14"/>
                              <path d="M12 5l7 7-7 7"/>
                            </svg>
                          </span>
                          <span>{{ link.title }}</span>
                        </a>
                      </li>
                    {%- endfor -%}
                  </ul>
                {%- else -%}
                  <ul class="cf-top__menu-list">
                    <li><a href="#" class="cf-top__menu-link"><span>Select a menu in settings</span></a></li>
                  </ul>
                {%- endif -%}
              </div>
            </div>

          {%- when 'social' -%}
            <div class="cf-top__col cf-top__col--social" {{ block.shopify_attributes }}>
              <div class="cf-top__heading-wrap" data-collapse-toggle>
                <h3 class="cf-top__heading">{{ block.settings.heading }}</h3>
                <span class="cf-top__collapse-icon" aria-hidden="true">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M6 9l6 6 6-6"/>
                  </svg>
                </span>
              </div>

              <div class="cf-top__content" data-collapse-content>
                {%- if block.settings.description != blank -%}
                  <p class="cf-top__social-desc">{{ block.settings.description }}</p>
                {%- endif -%}

                <ul class="cf-top__social-list">
                  {%- if block.settings.facebook != blank -%}
                    <li>
                      <a href="{{ block.settings.facebook }}" class="cf-top__social-link" aria-label="Facebook" target="_blank" rel="noopener">
                        <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                          <path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/>
                        </svg>
                      </a>
                    </li>
                  {%- endif -%}

                  {%- if block.settings.instagram != blank -%}
                    <li>
                      <a href="{{ block.settings.instagram }}" class="cf-top__social-link" aria-label="Instagram" target="_blank" rel="noopener">
                        <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                          <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.052.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98C8.333 23.986 8.741 24 12 24c3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 100 12.324 6.162 6.162 0 000-12.324zM12 16a4 4 0 110-8 4 4 0 010 8zm6.406-11.845a1.44 1.44 0 100 2.881 1.44 1.44 0 000-2.881z"/>
                        </svg>
                      </a>
                    </li>
                  {%- endif -%}

                  {%- if block.settings.youtube != blank -%}
                    <li>
                      <a href="{{ block.settings.youtube }}" class="cf-top__social-link" aria-label="YouTube" target="_blank" rel="noopener">
                        <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                          <path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/>
                        </svg>
                      </a>
                    </li>
                  {%- endif -%}

                  {%- if block.settings.twitter != blank -%}
                    <li>
                      <a href="{{ block.settings.twitter }}" class="cf-top__social-link" aria-label="Twitter" target="_blank" rel="noopener">
                        <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                          <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/>
                        </svg>
                      </a>
                    </li>
                  {%- endif -%}

                  {%- if block.settings.tiktok != blank -%}
                    <li>
                      <a href="{{ block.settings.tiktok }}" class="cf-top__social-link" aria-label="TikTok" target="_blank" rel="noopener">
                        <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                          <path d="M12.525.02c1.31-.02 2.61-.01 3.91-.02.08 1.53.63 3.09 1.75 4.17 1.12 1.11 2.7 1.62 4.24 1.79v4.03c-1.44-.05-2.89-.35-4.2-.97-.57-.26-1.1-.59-1.62-.93-.01 2.92.01 5.84-.02 8.75-.08 1.4-.54 2.79-1.35 3.94-1.31 1.92-3.58 3.17-5.91 3.21-1.43.08-2.86-.31-4.08-1.03-2.02-1.19-3.44-3.37-3.65-5.71-.02-.5-.03-1-.01-1.49.18-1.9 1.12-3.72 2.58-4.96 1.66-1.44 3.98-2.13 6.15-1.72.02 1.48-.04 2.96-.04 4.44-.99-.32-2.15-.23-3.02.37-.63.41-1.11 1.04-1.36 1.75-.21.51-.15 1.07-.14 1.61.24 1.64 1.82 3.02 3.5 2.87 1.12-.01 2.19-.66 2.77-1.61.19-.33.4-.67.41-1.06.1-1.79.06-3.57.07-5.36.01-4.03-.01-8.05.02-12.07z"/>
                        </svg>
                      </a>
                    </li>
                  {%- endif -%}

                  {%- if block.settings.whatsapp != blank -%}
                    <li>
                      <a href="{{ block.settings.whatsapp }}" class="cf-top__social-link" aria-label="WhatsApp" target="_blank" rel="noopener">
                        <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                          <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/>
                        </svg>
                      </a>
                    </li>
                  {%- endif -%}
                </ul>
              </div>
            </div>

          {%- when 'newsletter' -%}
            <div class="cf-top__col cf-top__col--newsletter" {{ block.shopify_attributes }}>
              <div class="cf-top__heading-wrap" data-collapse-toggle>
                <h3 class="cf-top__heading">{{ block.settings.heading }}</h3>
                <span class="cf-top__collapse-icon" aria-hidden="true">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M6 9l6 6 6-6"/>
                  </svg>
                </span>
              </div>

              <div class="cf-top__content" data-collapse-content>
                {%- if block.settings.description != blank -%}
                  <p class="cf-top__newsletter-desc">{{ block.settings.description }}</p>
                {%- endif -%}

                {%- form 'customer', class: 'cf-top__newsletter-form', novalidate: 'novalidate' -%}
                  <input type="hidden" name="contact[tags]" value="newsletter">

                  <div class="cf-top__input-wrap">
                    <input
                      type="email"
                      name="contact[email]"
                      id="cf-newsletter-{{ section.id }}"
                      class="cf-top__input"
                      placeholder="{{ block.settings.placeholder | default: 'Your email address' }}"
                      required
                      autocomplete="email"
                    >
                    <button type="submit" class="cf-top__submit" aria-label="Subscribe">
                      <span class="cf-top__submit-text">{{ block.settings.button_text | default: 'Subscribe' }}</span>
                      <span class="cf-top__submit-icon" aria-hidden="true">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                          <path d="M5 12h14"/>
                          <path d="M12 5l7 7-7 7"/>
                        </svg>
                      </span>
                    </button>
                  </div>

                  {%- if form.errors -%}
                    <div class="cf-top__form-message cf-top__form-message--error">
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <circle cx="12" cy="12" r="10"/>
                        <line x1="12" y1="8" x2="12" y2="12"/>
                        <line x1="12" y1="16" x2="12.01" y2="16"/>
                      </svg>
                      {{ form.errors.translated_fields.email | capitalize }} {{ form.errors.messages.email }}
                    </div>
                  {%- endif -%}

                  {%- if form.posted_successfully? -%}
                    <div class="cf-top__form-message cf-top__form-message--success">
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/>
                        <polyline points="22 4 12 14.01 9 11.01"/>
                      </svg>
                      {{ block.settings.success_message | default: 'Thanks for subscribing!' }}
                    </div>
                  {%- endif -%}
                {%- endform -%}

                {%- if block.settings.badges_enabled -%}
                  <div class="cf-top__trust-badges">
                    <span class="cf-top__trust-badge">
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <rect x="3" y="11" width="18" height="11" rx="2" ry="2"/>
                        <path d="M7 11V7a5 5 0 0 1 10 0v4"/>
                      </svg>
                      No spam
                    </span>
                    <span class="cf-top__trust-badge">
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M20 6L9 17l-5-5"/>
                      </svg>
                      Unsubscribe anytime
                    </span>
                  </div>
                {%- endif -%}
              </div>
            </div>

        {%- endcase -%}
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Custom Footer Top",
  "tag": "section",
  "class": "cf-top-section",
  "settings": [
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "background-1"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background color",
      "default": "#f6f6f8"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading color",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#6b7280"
    },
    {
      "type": "color",
      "id": "link_color",
      "label": "Link color",
      "default": "#6b7280"
    },
    {
      "type": "color",
      "id": "link_hover_color",
      "label": "Link hover color",
      "default": "#17a953"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent color",
      "default": "#17a953"
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "Border color",
      "default": "#e5e7eb"
    },
    {
      "type": "header",
      "content": "Spacing (Desktop)"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding top",
      "min": 0,
      "max": 150,
      "step": 5,
      "unit": "px",
      "default": 75
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding bottom",
      "min": 0,
      "max": 150,
      "step": 5,
      "unit": "px",
      "default": 40
    },
    {
      "type": "header",
      "content": "Spacing (Mobile)"
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "label": "Padding top (mobile)",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "default": 45
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "label": "Padding bottom (mobile)",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "default": 20
    }
  ],
  "blocks": [
    {
      "type": "contact",
      "name": "Contact Info",
      "limit": 1,
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Contact Us"
        },
        {
          "type": "textarea",
          "id": "address",
          "label": "Address",
          "default": "Shop #2, Omrbin Khattb Mosjid Market, Greatwall City, Gazipur"
        },
        {
          "type": "text",
          "id": "email",
          "label": "Email",
          "default": "grammofoods@gmail.com"
        },
        {
          "type": "text",
          "id": "phone",
          "label": "Phone",
          "default": "+8809611900245"
        },
        {
          "type": "text",
          "id": "hours",
          "label": "Working hours",
          "default": "Sat - Thu: 9:00 AM - 8:00 PM"
        }
      ]
    },
    {
      "type": "menu",
      "name": "Menu",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Information"
        },
        {
          "type": "link_list",
          "id": "menu",
          "label": "Menu",
          "default": "footer"
        }
      ]
    },
    {
      "type": "social",
      "name": "Social Links",
      "limit": 1,
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Follow Us"
        },
        {
          "type": "text",
          "id": "description",
          "label": "Description",
          "default": "Stay connected on social media"
        },
        {
          "type": "url",
          "id": "facebook",
          "label": "Facebook URL"
        },
        {
          "type": "url",
          "id": "instagram",
          "label": "Instagram URL"
        },
        {
          "type": "url",
          "id": "youtube",
          "label": "YouTube URL"
        },
        {
          "type": "url",
          "id": "twitter",
          "label": "Twitter / X URL"
        },
        {
          "type": "url",
          "id": "tiktok",
          "label": "TikTok URL"
        },
        {
          "type": "url",
          "id": "whatsapp",
          "label": "WhatsApp URL"
        }
      ]
    },
    {
      "type": "newsletter",
      "name": "Newsletter",
      "limit": 1,
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Sign Up & Save"
        },
        {
          "type": "textarea",
